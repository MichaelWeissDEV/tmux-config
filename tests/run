#!/usr/bin/env sh
# ==============================================================================
#  tests/run — the full test suite
# ==============================================================================
#
#  Usage:  ./tests/run          everything
#          ./tests/run matrix   only the TERM/locale matrix
#
#  What this covers that `scripts/check` does not: it loads the config under a
#  RANGE of environments and asserts the resulting behaviour, rather than
#  checking the config in one environment. Capability degradation is only real
#  if it is exercised.
#
#  Exit status: 0 all passed, 1 otherwise.
# ==============================================================================

set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PASS=0; FAIL=0
STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT

# Materialise the repo with paths rewritten, so tests run against the working
# tree whether or not it is the installed copy.
build() {
  rm -rf "$STAGE/cfg"; mkdir -p "$STAGE/cfg"
  for d in config capabilities terminals plugins scripts keys; do
    [ -d "$ROOT/$d" ] && cp -R "$ROOT/$d" "$STAGE/cfg/$d"
  done
  sed "s|~/.config/tmux|$STAGE/cfg|g; s|\$HOME/.config/tmux|$STAGE/cfg|g" \
    "$ROOT/tmux.conf" > "$STAGE/cfg/tmux.conf"
  for f in "$STAGE"/cfg/*/*.conf; do
    [ -f "$f" ] || continue
    sed "s|~/.config/tmux|$STAGE/cfg|g; s|\$HOME/.config/tmux|$STAGE/cfg|g" "$f" > "$f.n" \
      && mv "$f.n" "$f"
  done
}

# opt <name> <value> — override an option in the staged copy
opt() {
  sed "s|^set -g $1 .*|set -g $1 \"$2\"|" "$STAGE/cfg/config/00-options.conf" > "$STAGE/o" \
    && mv "$STAGE/o" "$STAGE/cfg/config/00-options.conf"
}

# start <socket> [env...] — load the staged config, return once settled
start() {
  s="$1"; shift
  env "$@" tmux -f "$STAGE/cfg/tmux.conf" -L "$s" new-session -d 2>"$STAGE/err"
  sleep 0.8
}
stop() { tmux -L "$1" kill-server 2>/dev/null; }
val()  { tmux -L "$1" show -gv "$2" 2>/dev/null; }

assert() { # assert <label> <expected> <actual>
  if [ "$2" = "$3" ]; then
    PASS=$((PASS+1)); printf '  ok    %s\n' "$1"
  else
    FAIL=$((FAIL+1)); printf '  FAIL  %s\n        expected "%s", got "%s"\n' "$1" "$2" "$3"
  fi
}
assert_ne() {
  if [ "$2" != "$3" ]; then PASS=$((PASS+1)); printf '  ok    %s\n' "$1"
  else FAIL=$((FAIL+1)); printf '  FAIL  %s (should not be "%s")\n' "$1" "$2"; fi
}

printf '\ntmux-config tests\n'

# ------------------------------------------------------------------------------
printf '\nLoads cleanly under each TERM\n'
# ------------------------------------------------------------------------------
#  Not an emulation of these terminals — the point is that the config never
#  errors and always produces a usable colour setting, however odd TERM is.
build
for t in xterm xterm-256color screen screen-256color tmux tmux-256color \
         xterm-kitty alacritty foot wezterm linux dumb vt100; do
  start "t-$t" "TERM=$t" LANG=en_US.UTF-8
  E="$(cat "$STAGE/err")"
  A="$(val "t-$t" @thm_accent)"
  if [ -z "$E" ] && [ -n "$A" ]; then
    PASS=$((PASS+1)); printf '  ok    TERM=%-16s colors=%s\n' "$t" "$(val "t-$t" @cap_colors)"
  else
    FAIL=$((FAIL+1)); printf '  FAIL  TERM=%-16s err=%s accent=%s\n' "$t" "$E" "$A"
  fi
  stop "t-$t"
done

# ------------------------------------------------------------------------------
printf '\nCapability detection\n'
# ------------------------------------------------------------------------------
build
start c1 TERM=xterm-256color COLORTERM=truecolor LANG=en_US.UTF-8
assert "COLORTERM=truecolor detected"    "yes"  "$(val c1 @cap_truecolor)"
assert "  and colour depth is 16m"       "16m"  "$(val c1 @cap_colors)"
assert "UTF-8 locale detected"           "yes"  "$(val c1 @cap_utf8)"
assert "not flagged as SSH"              "no"   "$(val c1 @cap_ssh)"
stop c1

start c2 TERM=xterm-256color LC_ALL=C LANG=C
assert "non-UTF-8 locale detected"       "no"   "$(val c2 @cap_utf8)"
assert "  falls back to ASCII separator" "|"    "$(val c2 @sym_sep)"
assert "  and ASCII dot"                 "-"    "$(val c2 @sym_dot)"
stop c2

start c3 TERM=xterm-256color LANG=en_US.UTF-8 SSH_CONNECTION="10.0.0.1 22 10.0.0.2 22"
assert "SSH detected"                    "yes"  "$(val c3 @cap_ssh)"
stop c3

start c4 TERM=linux LANG=en_US.UTF-8
assert "linux console is 16 colours"     "16"   "$(val c4 @cap_colors)"
assert "  and not truecolor"             "no"   "$(val c4 @cap_truecolor)"
stop c4

start c5 TERM=xterm-kitty LANG=en_US.UTF-8
assert "kitty inferred as truecolor"     "yes"  "$(val c5 @cap_truecolor)"
stop c5

# ------------------------------------------------------------------------------
printf '\nTri-state overrides beat detection\n'
# ------------------------------------------------------------------------------
build; opt @cfg_symbols ascii
start o1 TERM=xterm-256color LANG=en_US.UTF-8
assert "symbols=ascii forces ASCII despite UTF-8" "|" "$(val o1 @sym_sep)"
stop o1

build; opt @cfg_symbols unicode
start o2 TERM=xterm-256color LC_ALL=C LANG=C
assert_ne "symbols=unicode forces Unicode despite C locale" "|" "$(val o2 @sym_sep)"
stop o2

build; opt @cfg_extended_keys off
start o3 TERM=xterm-256color LANG=en_US.UTF-8
assert "extended_keys=off applied" "off" "$(tmux -L o3 show -sv extended-keys 2>/dev/null)"
stop o3

# ------------------------------------------------------------------------------
printf '\nNeovim input safety (the hard rule)\n'
# ------------------------------------------------------------------------------
build
start n1 TERM=xterm-256color LANG=en_US.UTF-8
RK="$(tmux -L n1 list-keys -T root 2>/dev/null)"
UNSAFE=""
for k in C-h C-j C-k C-l C-w C-v C-o Escape; do
  printf '%s' "$RK" | grep -qE "^bind-key +-T root +$k " && UNSAFE="$UNSAFE $k"
done
assert "no Ctrl key intercepted by default" "" "$UNSAFE"
stop n1

# The navigator plugin is the documented exception — it MUST intercept.
build; opt @cfg_plugins on; opt @cfg_plugin_navigator on
start n2 TERM=xterm-256color LANG=en_US.UTF-8
assert "config still loads with navigator on" "" "$(cat "$STAGE/err")"
stop n2

# ------------------------------------------------------------------------------
printf '\nKey model — tmux defaults stay tmux\n'
# ------------------------------------------------------------------------------
#  The project's central promise: a tmux user sitting down at this config finds
#  tmux where they left it. These assertions are what stop that promise being
#  quietly broken by a future convenience binding.
#
#  `bound` reads the live command for one key. It anchors on -T rather than a
#  field index, because the optional -r/-n flags shift every column, and it
#  unescapes the key (tmux prints `\"` for `"`) so it can be compared.
bound() { # bound <socket> <table> <key>
  tmux -L "$1" list-keys -T "$2" 2>/dev/null | awk -v tbl="$2" -v want="$3" '
    { ti = 0; for (i = 1; i <= NF; i++) if ($i == "-T") { ti = i; break } }
    ti && $(ti + 1) == tbl {
      k = $(ti + 2); sub(/^\\/, "", k)
      if (k != want) next
      c = ""; for (i = ti + 3; i <= NF; i++) c = c (c == "" ? "" : " ") $i
      print c; exit
    }'
}

build
start k1 TERM=xterm-256color LANG=en_US.UTF-8

# --- reserved tmux keys, restored ---
assert "prefix ? is still tmux list-keys"       "list-keys -N"     "$(bound k1 prefix '?')"
assert "prefix / is still tmux describe-key"    "command-prompt -k -p key { list-keys -1N \"%%\" }" "$(bound k1 prefix '/')"
assert "prefix r is still tmux refresh-client"  "refresh-client"   "$(bound k1 prefix 'r')"
assert "prefix - is still tmux delete-buffer"   "delete-buffer"    "$(bound k1 prefix '-')"
assert "prefix = is still tmux choose-buffer"   "choose-buffer -Z" "$(bound k1 prefix '=')"
assert "prefix p is still tmux previous-window" "previous-window"  "$(bound k1 prefix 'p')"

# --- the framework's own keys ---
case "$(bound k1 prefix 'R')" in
  source-file*) assert "prefix R reloads the config" "yes" "yes" ;;
  *)            assert "prefix R reloads the config" "source-file ..." "$(bound k1 prefix 'R')" ;;
esac
case "$(bound k1 prefix 'H')" in
  *key-explorer*) assert "prefix H opens the Key Explorer" "yes" "yes" ;;
  *)              assert "prefix H opens the Key Explorer" "display-popup key-explorer" "$(bound k1 prefix 'H')" ;;
esac

# --- Alt-number window keys survive ---
ALTOK=yes
for n in 1 2 3 4 5 6 7 8 9; do
  [ "$(bound k1 root "M-$n")" = "select-window -t :=$n" ] || ALTOK="M-$n missing"
done
assert "Alt-1..9 select windows without the prefix" "yes" "$ALTOK"

# --- copy mode: both tables complete, vi keys as vi means them ---
VI_N="$(tmux -L k1 list-keys -T copy-mode-vi 2>/dev/null | grep -c ' -T copy-mode-vi ')"
EM_N="$(tmux -L k1 list-keys -T copy-mode 2>/dev/null | grep -c ' -T copy-mode ')"
[ "$VI_N" -ge 80 ] && assert "copy-mode-vi table is complete ($VI_N keys)" "ok" "ok" \
                   || assert "copy-mode-vi table is complete" ">= 80 keys" "$VI_N"
[ "$EM_N" -ge 70 ] && assert "copy-mode table is complete ($EM_N keys)" "ok" "ok" \
                   || assert "copy-mode table is complete" ">= 70 keys" "$EM_N"

assert "copy-mode-vi H is still top-line"       "send-keys -X top-line"      "$(bound k1 copy-mode-vi 'H')"
assert "copy-mode-vi L is still bottom-line"    "send-keys -X bottom-line"   "$(bound k1 copy-mode-vi 'L')"
assert "copy-mode-vi C-v is still rectangle"    "send-keys -X rectangle-toggle" "$(bound k1 copy-mode-vi 'C-v')"
assert "copy-mode-vi v begins a selection"      "send-keys -X begin-selection"  "$(bound k1 copy-mode-vi 'v')"
assert "copy-mode-vi y copies and cancels"      "send-keys -X copy-pipe-and-cancel" "$(bound k1 copy-mode-vi 'y')"
stop k1

# ------------------------------------------------------------------------------
printf '\nKey Explorer\n'
# ------------------------------------------------------------------------------
#  Rule 17 and 18: the Explorer must work with nothing but a POSIX shell. The
#  interactive UI cannot be driven headlessly, but its whole data model can —
#  and the data model is where a key reference goes wrong.

build
start ke TERM=xterm-256color LANG=en_US.UTF-8

# Rule 18: fzf is an enhancement and must never be a dependency. A booby-trapped
# `fzf` first on PATH proves it directly — it records any call and then fails,
# so an Explorer that reached for it would both leave a marker and break.
TRAPBIN="$STAGE/trapbin"; mkdir -p "$TRAPBIN"
printf '#!/bin/sh\ntouch "%s/fzf-was-called"\nexit 1\n' "$STAGE" > "$TRAPBIN/fzf"
chmod +x "$TRAPBIN/fzf"
rm -f "$STAGE/fzf-was-called"
QOUT="$(PATH="$TRAPBIN:$PATH" "$STAGE/cfg/scripts/key-explorer" --dump quick 2>"$STAGE/kerr")"
QN="$(printf '%s\n' "$QOUT" | grep -c . || true)"
if [ -f "$STAGE/fzf-was-called" ]; then
  assert "the Key Explorer never requires fzf" "not called" "fzf was called"
elif [ "$QN" -gt 0 ]; then
  assert "the Key Explorer never requires fzf ($QN quick keys)" "ok" "ok"
else
  assert "the Key Explorer never requires fzf" "rows" "$(cat "$STAGE/kerr")"
fi

"$STAGE/cfg/scripts/key-explorer" --socket ke --dump active > "$STAGE/ke-active.tsv"
A_BASE="$(wc -l < "$STAGE/ke-active.tsv" | tr -d ' ')"
assert_ne "active view lists bindings" "0" "$A_BASE"

# Nothing may be reported as an unexplained local binding on a stock config.
UNEXPL="$(awk -F'\t' '$8=="local"' "$STAGE/ke-active.tsv" | wc -l | tr -d ' ')"
assert "no unexplained live bindings on a stock config" "0" "$UNEXPL"
stop ke

# --- plugin keys appear only while the plugin is on ---
#  This is the pair of assertions that proves the Active view reads the server
#  rather than a stale file.
if [ -d "$ROOT/vendor/tmux-resurrect" ]; then
  build
  cp -R "$ROOT/vendor" "$STAGE/cfg/vendor"
  for f in "$STAGE"/cfg/plugins/*.conf; do
    sed "s|\$HOME/.config/tmux|$STAGE/cfg|g" "$f" > "$f.n" && mv "$f.n" "$f"
  done
  opt @cfg_plugins on; opt @cfg_plugin_resurrect on
  start kp TERM=xterm-256color LANG=en_US.UTF-8
  sleep 1.2
  "$STAGE/cfg/scripts/key-explorer" --socket kp --dump active > "$STAGE/ke-plug.tsv"
  PLUGKEYS="$(awk -F'\t' '$8=="local" && $9 ~ /resurrect/' "$STAGE/ke-plug.tsv" | wc -l | tr -d ' ')"
  [ "$PLUGKEYS" -gt 0 ] \
    && assert "plugin keys appear when the plugin is on ($PLUGKEYS)" "ok" "ok" \
    || assert "plugin keys appear when the plugin is on" ">0" "$PLUGKEYS"
  stop kp

  build
  start kq TERM=xterm-256color LANG=en_US.UTF-8
  "$STAGE/cfg/scripts/key-explorer" --socket kq --dump active > "$STAGE/ke-noplug.tsv"
  GONE="$(awk -F'\t' '$9 ~ /resurrect/' "$STAGE/ke-noplug.tsv" | wc -l | tr -d ' ')"
  assert "plugin keys disappear when the plugin is off" "0" "$GONE"
  stop kq
fi

# ------------------------------------------------------------------------------
printf '\nKey registry\n'
# ------------------------------------------------------------------------------
#  Every captured upstream snapshot must still parse. A snapshot is only useful
#  if every consumer can read it, and a half-written capture is worse than none.
SNAPBAD=""
for f in "$ROOT"/keys/upstream/tmux-*.tsv; do
  [ -f "$f" ] || continue
  v="$(basename "$f" .tsv)"
  BADL="$(awk -F'\t' 'NR>4 && NF!=5 {n++} END{print n+0}' "$f")"
  ROWS="$(awk -F'\t' 'NR>4' "$f" | wc -l | tr -d ' ')"
  [ "$BADL" = "0" ] && [ "$ROWS" -gt 0 ] || SNAPBAD="$SNAPBAD $v"
done
assert "every upstream keymap snapshot parses" "" "$SNAPBAD"

if [ -x "$ROOT/scripts/check-key-conflicts" ]; then
  if "$ROOT/scripts/check-key-conflicts" >/dev/null 2>&1; then
    assert "no tmux default is repurposed" "ok" "ok"
  else
    assert "no tmux default is repurposed" "ok" "see ./scripts/check-key-conflicts"
  fi
fi

# ------------------------------------------------------------------------------
if ! "$ROOT/tests/window-status"; then
  FAIL=$((FAIL+1))
fi

# ------------------------------------------------------------------------------
printf '\nOption round-trip\n'
# ------------------------------------------------------------------------------
build; opt @cfg_history_limit 4242; opt @cfg_escape_time 25; opt @cfg_base_index 0
start r1 TERM=xterm-256color LANG=en_US.UTF-8
assert "history-limit passed through" "4242" "$(val r1 history-limit)"
assert "escape-time passed through"   "25"   "$(tmux -L r1 show -sv escape-time)"
assert "base-index passed through"    "0"    "$(val r1 base-index)"
stop r1

build
for th in catppuccin-mocha catppuccin-latte tokyonight nord gruvbox-dark rose-pine; do
  opt @cfg_theme "$th"
  start "th-$th" TERM=xterm-256color LANG=en_US.UTF-8
  A="$(val "th-$th" @thm_accent)"
  case "$A" in "#"*) PASS=$((PASS+1)); printf '  ok    theme %s -> %s\n' "$th" "$A" ;;
               *) FAIL=$((FAIL+1)); printf '  FAIL  theme %s -> "%s"\n' "$th" "$A" ;; esac
  stop "th-$th"
  build
done

# ------------------------------------------------------------------------------
printf '\nPlugin binding overrides (informational)\n'
# ------------------------------------------------------------------------------
#  `scripts/check` cannot see these: it runs with the shipped defaults, where
#  every plugin is off. But a plugin binding a key this config already uses is
#  exactly the kind of surprise worth surfacing — the failure mode is a key
#  that quietly does something else after you enable a plugin.
#
#  This is reported, not asserted. A plugin overriding a key is upstream
#  behaviour, not a defect in this project; the point is that it is written
#  down rather than discovered mid-workflow.

build
start pb0 TERM=xterm-256color LANG=en_US.UTF-8
tmux -L pb0 list-keys -T prefix 2>/dev/null \
  | awk '{for(i=1;i<NF;i++) if($i=="prefix"){k=$(i+1);$1="";$2="";$3="";$4="";sub(/^ +/,"");print k"\t"$0;exit}}' >/dev/null
tmux -L pb0 list-keys -T prefix 2>/dev/null \
  | awk '{for(i=1;i<NF;i++) if($i=="prefix"){k=$(i+1);$1="";$2="";$3="";$4="";sub(/^ +/,"");print k"\t"$0;break}}' \
  | sort > "$STAGE/keys.base"
stop pb0

for pl in resurrect continuum navigator open sessionist logging extrakto fpp; do
  case "$pl" in
    resurrect) dir=tmux-resurrect ;;      continuum) dir=tmux-continuum ;;
    navigator) dir=vim-tmux-navigator ;;  open) dir=tmux-open ;;
    sessionist) dir=tmux-sessionist ;;    logging) dir=tmux-logging ;;
    extrakto) dir=extrakto ;;             fpp) dir=tmux-fpp ;;
  esac
  [ -d "$ROOT/vendor/$dir" ] || continue

  build
  cp -R "$ROOT/vendor" "$STAGE/cfg/vendor"
  for f in "$STAGE"/cfg/plugins/*.conf; do
    sed "s|\$HOME/.config/tmux|$STAGE/cfg|g" "$f" > "$f.n" && mv "$f.n" "$f"
  done
  opt @cfg_plugins on
  opt "@cfg_plugin_$pl" on
  start "pb-$pl" TERM=xterm-256color LANG=en_US.UTF-8
  sleep 1.2
  tmux -L "pb-$pl" list-keys -T prefix 2>/dev/null \
    | awk '{for(i=1;i<NF;i++) if($i=="prefix"){k=$(i+1);$1="";$2="";$3="";$4="";sub(/^ +/,"");print k"\t"$0;break}}' \
    | sort > "$STAGE/keys.$pl"

  # A key present in both, bound to something different, is an override.
  OVER="$(join -t"$(printf '\t')" "$STAGE/keys.base" "$STAGE/keys.$pl" 2>/dev/null \
          | awk -F"\t" '$2 != $3 {
              # Collapse the staged vendor path so the report stays readable.
              a=$2; b=$3
              gsub(/[^ ]*\/vendor\//, "", b); gsub(/[^ ]*\/vendor\//, "", a)
              printf "        %-4s %s  ->  %s\n", $1":", a, b
            }')"
  if [ -n "$OVER" ]; then
    printf '  note  %s overrides:\n%s\n' "$pl" "$OVER"
  else
    printf '  ok    %s adds no conflicting binding\n' "$pl"
  fi
  stop "pb-$pl"
done

# ------------------------------------------------------------------------------
printf '\n%d passed, %d failed\n\n' "$PASS" "$FAIL"
[ "$FAIL" -gt 0 ] && exit 1
exit 0
