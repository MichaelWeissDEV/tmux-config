#!/usr/bin/env sh
# ==============================================================================
#  gen-upstream-keys — capture tmux's OWN default keymap into keys/upstream/
# ==============================================================================
#
#  Usage:  ./scripts/gen-upstream-keys            capture the tmux on PATH
#          ./scripts/gen-upstream-keys --stdout   print instead of writing
#          ./scripts/gen-upstream-keys --check    fail if the snapshot is stale
#
#  Writes  keys/upstream/tmux-<version>.tsv
#
#  WHY THIS EXISTS
#  ---------------
#  The registry's upstream half must come from tmux itself — not from a blog,
#  a cheat sheet, or anybody's memory. This script is the only sanctioned way
#  a file under keys/upstream/ is allowed to come into existence.
#
#  You get the snapshot for whatever tmux you are running. To add another
#  version, run this under that tmux; CI does exactly that across a version
#  matrix (see .github/workflows/ci.yml, job `upstream-keys`).
#
#  THE PRISTINE-SERVER TRAP  — read before touching the tmux invocation
#  --------------------------------------------------------------------
#  `tmux -f /dev/null` does NOT give you a default server. /dev/null is not a
#  regular file, tmux falls back to its normal config search, and your personal
#  ~/.tmux.conf gets loaded — so the "defaults" you capture are your own
#  config. This was observed, not theorised.
#
#  An empty REGULAR file is the only reliable way to say "no configuration".
#  The environment is scrubbed too, so a stray $TMUX or $TMUX_TMPDIR cannot
#  attach us to an existing server that already has bindings loaded.
# ==============================================================================

set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Pin collation: `sort` orders punctuation differently under C vs a UTF-8
# locale, and these files are compared byte for byte by CI.
LC_ALL=C
export LC_ALL

MODE=write
case "${1:-}" in
  --stdout) MODE=stdout ;;
  --check)  MODE=check ;;
  "")       ;;
  *) printf 'usage: %s [--stdout|--check]\n' "$0" >&2; exit 2 ;;
esac

command -v tmux >/dev/null 2>&1 || { printf 'tmux not found on PATH\n' >&2; exit 1; }

VERSION="$(tmux -V | sed 's/^tmux //')"

TMPD="$(mktemp -d)"
SOCKET="upstreamkeys-$$"
cleanup() {
  env -u TMUX tmux -L "$SOCKET" kill-server 2>/dev/null || true
  rm -rf "$TMPD"
}
trap cleanup EXIT

# An EMPTY REGULAR FILE — see the trap note above. Not /dev/null.
: > "$TMPD/empty.conf"

env -u TMUX -u TMUX_TMPDIR tmux -f "$TMPD/empty.conf" -L "$SOCKET" \
  new-session -d 2>/dev/null

# Guard against capturing a contaminated server. If any personal config had
# leaked in, this option would exist; on a pristine server it is unknown.
if env -u TMUX tmux -L "$SOCKET" show -gv @cfg_prefix >/dev/null 2>&1; then
  printf 'refusing to capture: the tmux server is not pristine (@cfg_prefix is set)\n' >&2
  exit 1
fi

# ------------------------------------------------------------------------------
#  Emit
# ------------------------------------------------------------------------------
#  Two tmux views are combined, because neither alone is enough:
#
#    list-keys      bind-key [-nr] -T <table> <key> <command...>
#    list-keys -N   <key>  <description>       (the note tmux ships per binding)
#
#  From the first: the flags before -T are optional and shift every column, so
#  no field index is safe. `-T` is the anchor — the table follows it and the key
#  follows the table. The FIRST -T is the binding's own, because bind flags
#  precede the command; a command may itself contain -T (`command-prompt -T
#  target`), which is why "first" matters and "last" would be wrong.
#
#  From the second: tmux documents its own defaults. Those descriptions are
#  authoritative and cost nothing, so we never write our own for an upstream
#  key. Only the copy-mode tables ship without notes; there the command name
#  itself (`halfpage-up`) is humanised, which is still tmux's own word.
#
#  JOINING THE TWO is the delicate part. `-N` output cannot be parsed on its
#  own: the key column is padded to an unknown width and the description may
#  contain anything. But both views list bindings in the same order, so we join
#  positionally — and then VERIFY that the -N line really does start with the
#  key we expect. A mismatch means tmux changed its output format, and we fail
#  loudly rather than shipping descriptions attached to the wrong keys.
#
#  Key escaping: `list-keys` escapes specials (`\"`, `\#`, `\$`), `-N` does not.
#  The registry stores the UNESCAPED form — it is what you actually press, and
#  it is what makes the two views comparable.

unescape_key() { sed 's/^\\//'; }

emit() {
  printf '# tmux-config upstream keymap snapshot\n'
  printf '# source: tmux %s, captured by scripts/gen-upstream-keys\n' "$VERSION"
  printf '# DO NOT EDIT BY HAND — regenerate under the matching tmux version.\n'
  printf 'table\tkey\trepeatable\tcommand\tdescription\n'

  for table in prefix root copy-mode copy-mode-vi; do
    env -u TMUX tmux -L "$SOCKET" list-keys -T "$table" 2>/dev/null | awk -v tbl="$table" '
      {
        ti = 0
        for (i = 1; i <= NF; i++) if ($i == "-T") { ti = i; break }
        if (ti == 0) next                 # continuation line of a multi-line command
        if ($(ti + 1) != tbl) next

        rep = "no"
        for (i = 1; i < ti; i++) if ($i ~ /^-[a-zA-Z]*r[a-zA-Z]*$/) rep = "yes"

        key = $(ti + 2)
        sub(/^\\/, "", key)               # \" -> "   (see the escaping note)

        cmd = ""
        for (i = ti + 3; i <= NF; i++) cmd = cmd (cmd == "" ? "" : " ") $i

        # TSV integrity: a literal tab inside a command would create a phantom
        # column. tmux does not emit one today, but a future default with a tab
        # in a display-menu label would corrupt every downstream consumer.
        gsub(/\t/, " ", cmd)

        if (key == "" || cmd == "") next
        printf "%s\t%s\t%s\t%s\n", tbl, key, rep, cmd
      }
    ' > "$TMPD/bind.$table"

    env -u TMUX tmux -L "$SOCKET" list-keys -N -T "$table" 2>/dev/null \
      > "$TMPD/note.$table" || : > "$TMPD/note.$table"

    paste "$TMPD/bind.$table" "$TMPD/note.$table" | awk -F'\t' -v tbl="$table" '
      function titlecase(v) {
        gsub(/-/, " ", v)
        if (v == "") return "-"
        return toupper(substr(v, 1, 1)) substr(v, 2)
      }
      function humanise(c,   v) {
        # Reached when tmux ships no -N note, which in practice means the
        # copy-mode tables and the mouse bindings. Naming the FIRST command is
        # useless there: nearly every mouse binding opens with `select-pane` or
        # wraps itself in `if-shell`, so a whole column would read "If shell".
        #
        # The most specific command in the chain wins instead, in this order:
        # a context menu, then a copy-mode verb, then whatever runs first.
        # Every one of those words is tmux own — none is invented here.
        if (c ~ /display-menu/) return "Display the context menu"

        if (c ~ /send-keys +-[A-Za-z]*X[A-Za-z]* /) {
          v = c
          sub(/^.*send-keys +-[A-Za-z]*X[A-Za-z]* +/, "", v)
          sub(/^-- +/, "", v)
          sub(/ .*$/, "", v)
          if (v != "" && v !~ /^[-"]/) return titlecase(v)
        }

        v = c
        sub(/ .*$/, "", v)
        return titlecase(v)
      }
      {
        key = $2; cmd = $4; note = $5

        # Strip the leading prefix token the -N view prints for the prefix
        # table ("C-b Space  Select next layout"), then require the expected
        # key at the start. Anything else means the format moved under us.
        if (note != "") {
          if (tbl == "prefix") sub(/^[^ ]+ +/, "", note)
          if (substr(note, 1, length(key)) == key) {
            note = substr(note, length(key) + 1)
            sub(/^ +/, "", note)
          } else {
            print "JOIN-MISMATCH\t" tbl "\t" key "\t" note > "/dev/stderr"
            note = ""
          }
        }
        if (note == "") note = humanise(cmd)
        gsub(/\t/, " ", note)
        printf "%s\t%s\t%s\t%s\t%s\n", $1, key, $3, cmd, note
      }
    ' | sort -t"$(printf '\t')" -k2,2
  done
}

OUT="$ROOT/keys/upstream/tmux-$VERSION.tsv"

case "$MODE" in
  stdout) emit ;;
  check)
    if [ ! -f "$OUT" ]; then
      printf 'missing snapshot for tmux %s: %s\n' "$VERSION" "$OUT" >&2
      printf 'create it with: ./scripts/gen-upstream-keys\n' >&2
      exit 1
    fi
    if emit | diff -u "$OUT" - >/dev/null; then
      printf 'upstream snapshot for tmux %s is current\n' "$VERSION"
    else
      printf 'stale snapshot for tmux %s\n' "$VERSION" >&2
      emit | diff -u "$OUT" - >&2 || true
      exit 1
    fi
    ;;
  write)
    mkdir -p "$ROOT/keys/upstream"
    emit > "$OUT"
    printf 'wrote %s (%d bindings)\n' \
      "${OUT#"$ROOT"/}" "$(grep -vc '^#\|^table	' "$OUT" || true)"
    ;;
esac
