# ==============================================================================

# --- copy without leaving copy mode -------------------------------------------
# set -g @cfg_copy_stays_in_mode "on"

# --- yank the whole pane's visible text ---------------------------------------
# bind -N "Copy the visible pane" Y \
#   run-shell "tmux capture-pane -p | tmux load-buffer - && tmux display 'pane copied'"

# --- copy the current pane's path ---------------------------------------------
# bind -N "Copy the current path" C-y \
#   run-shell "printf '%s' '#{pane_current_path}' | tmux load-buffer - && tmux display 'path copied'"

# --- open a URL from the visible pane (needs fzf) ------------------------------
# bind -N "Open a URL from this pane" u display-popup -E -w 70% -h 40% "\
#   tmux capture-pane -p -S -3000 \
#   | grep -oE 'https?://[^ \"'\\'')>]+' | sort -u \
#   | fzf --reverse --header='open URL' \
#   | xargs -r \${BROWSER:-open}"


# ==============================================================================
#  7. Machine-specific configuration
# ==============================================================================
#  One dotfiles repo, different behaviour per host.

# if-shell -b '[ "$(hostname -s)" = "work-laptop" ]' " \
#   set -g @thm_accent '#f38ba8' ; \
#   set -g status-position top "

# Only on a remote host, so you can tell sessions apart at a glance.
# %if "#{==:#{@cap_ssh},yes}"
#   set -g @cfg_prefix "C-a"          # avoid clashing with the outer tmux
#   set -g @thm_accent "#f9e2af"      # visibly different colour when remote
# %endif

# On a machine without a UTF-8 locale you can force ASCII rather than relying
# on detection.
# %if "#{!=:#{@cap_utf8},yes}"
#   set -g @cfg_symbols "ascii"
# %endif


# ==============================================================================
#  8. Plugins
# ==============================================================================
#  Plugins are vendored in this repository — no plugin manager, no download at
#  startup. They must be vendored once by a maintainer:
#
#      ./scripts/update-vendor --list          what is available and present
#      ./scripts/update-vendor --add tmux-resurrect
#
#  Then enable them here. See docs/plugins.md.

# set -g @cfg_plugins "on"            # master switch — required for any plugin

# set -g @cfg_plugin_resurrect  "on"  # save/restore sessions across reboots
# set -g @cfg_plugin_continuum  "on"  # automatic save (requires resurrect)
# set -g @cfg_plugin_navigator  "on"  # shared Ctrl-hjkl with Neovim
# set -g @cfg_plugin_open       "on"  # open a file/URL from copy mode
# set -g @cfg_plugin_sessionist "on"  # extra session management
# set -g @cfg_plugin_logging    "on"  # save pane output to a file
# set -g @cfg_plugin_extrakto   "on"  # fuzzy-grab any text from the screen
# set -g @cfg_plugin_fpp        "on"  # pick a file path out of pane output

# --- plugin settings worth changing -------------------------------------------
# set -g @resurrect-processes 'ssh psql mysql sqlite3 top htop btop nvim'
# set -g @continuum-save-interval '5'
# set -g @extrakto_split_direction 'p'      # show extrakto in a popup
# set -g @logging-path "$HOME/tmux-logs"
